<Project>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <DefineConstants>$(DefineConstants);NET5_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472' OR '$(TargetFramework)' == 'net481'">
    <DefineConstants>$(DefineConstants);TRAKT_NET_4XX_FRAMEWORK_TARGET</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="('$(TargetFramework)' == 'netstandard2.0') OR ('$(TargetFramework)' == 'netstandard2.1')">
    <DefineConstants>$(DefineConstants);TRAKT_NETSTANDARD_TARGET</DefineConstants>
  </PropertyGroup>

</Project>
