<Project>

  <!-- Custom constants and variables. -->
  <PropertyGroup>
    <LibraryCopyright>© 2016 - 2025 by Henrik Fröhling and Contributors; © 2025 by José Fariña and Contributors</LibraryCopyright>

    <!-- NET (Framework | Standard) Targets -->
    <!-- Only used by the test projects: every .NET Framework 4.x target runs on the same in-place CLR and
         consumes the same netstandard2.0 library build, so the minimum supported version is enough. -->
    <LibraryNETFrameworkTargets>net472</LibraryNETFrameworkTargets>
    <LibraryNETStandardTargets>netstandard2.0;netstandard2.1</LibraryNETStandardTargets>
    <LibraryCommonNETTargets>net6.0;net7.0;net8.0;net9.0;net10.0;net11.0</LibraryCommonNETTargets>
    <LibraryCommonNETPreviewTargets></LibraryCommonNETPreviewTargets>

    <LibraryTargetFrameworks>$(LibraryNETStandardTargets);net5.0;$(LibraryCommonNETTargets)</LibraryTargetFrameworks>
    <HttpClientFactoryLibraryTargetFrameworks>$(LibraryNETStandardTargets);$(LibraryCommonNETTargets)</HttpClientFactoryLibraryTargetFrameworks>
    <!-- Tests run only on the supported .NET versions: the library has no conditional code above NET8_0_OR_GREATER,
         so net10.0 and net11.0 cover every code path of the net8.0+ builds. -->
    <SupportedNETTestTargets>net10.0;net11.0</SupportedNETTestTargets>
    <TestTargetFrameworks>$(LibraryNETFrameworkTargets);$(SupportedNETTestTargets)</TestTargetFrameworks>

    <!-- These tests use Verify packages which only support .NET versions >= 8 in combination with xUnit v3. -->
    <SourceGenerationTestTargetFrameworks>$(SupportedNETTestTargets)</SourceGenerationTestTargetFrameworks>

    <IsTestProject>$(MSBuildProjectName.EndsWith('Tests'))</IsTestProject>
    <IsTestUtilityProject>$(MSBuildProjectName.EndsWith('Tests.Utility'))</IsTestUtilityProject>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);1701;1702;1705;1591</NoWarn>
    <Copyright>$(LibraryCopyright)</Copyright>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TraktNET</RootNamespace>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
  </PropertyGroup>

</Project>
