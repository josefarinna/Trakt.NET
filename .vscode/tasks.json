            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "src/libs/Trakt.NET/Trakt.NET.Ex.csproj",
                "--configuration",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
