{
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/bin/Release/net9.0/Trakt.NET*.dll" ],
          "src": "../src/libs"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**", "filterConfig.yml" ]
      }
    ],
    "resource": [
      {
        "files": [ "**/images/**", "codesnippet/**" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "globalMetadata": {
      "_appTitle": "Trakt.NET",
      "_appName": "Trakt.NET",
      "_appFooter": "<span>Made with <a href='https://dotnet.github.io/docfx/'>docfx</a></span><br />Copyright © 2026 - Current José Fariña et al.",
      "_gitContribute": {
        "branch": "develop"
      }
    },
    "sitemap": {
      "baseUrl": "https://josefarinna.github.io/Trakt.NET",
      "priority": 0.1,
      "changefreq": "monthly"
    },
    "output": "_site",
    "template": [
      "default",
      "template"
    ]
  }
}
